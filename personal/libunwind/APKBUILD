# Contributor: Ben Pye <ben@curlybracket.co.uk>
maintainer="Krassy Boykinov <kboykinov@teamcentrixx.com>"
pkgname=libunwind
pkgver=1.8.3
pkgrel=0
pkgdesc="Portable and efficient C programming interface (API) to determine the call-chain of a program"
url="https://www.nongnu.org/libunwind/"
arch="all"
license="MIT"
depends_dev="libucontext-dev"
makedepends_build="autoconf automake libtool"
makedepends_host="$depends_dev linux-headers xz-dev"
makedepends="$makedepends_build $makedepends_host"
subpackages="$pkgname-dbg $pkgname-static $pkgname-dev"  #$pkgname-doc
source="https://github.com/libunwind/libunwind/releases/download/v$pkgver/libunwind-$pkgver.tar.gz
	force-enable-man.patch
	fix-libunwind-pc-in.patch
	Remove-the-useless-endina.h-for-loongarch64.patch
	gcc15.patch::https://github.com/libunwind/libunwind/commit/b67d508a93bf1ba231c18dce3894cfee25c16e0d.patch
	001-musl-support.patch.noauto::https://github.com/libunwind/libunwind/commit/75fe438e4adaa1666b39c4b08e22c1eb947b6986.patch
	002-musl-tests.patch.noauto::https://github.com/libunwind/libunwind/commit/3e72728f4f3219a5c1e05dcc5ccebd213744ff44.patch
	004-musl-aarch64-setjmp.patch.noauto::https://github.com/libunwind/libunwind/commit/bf6ee1169a19be73a415578db6030e117d71ef52.patch
	005-musl-ppc32.patch.noauto::https://github.com/libunwind/libunwind/commit/71559717599cecc4d1ccb2061766ec5c12e10ac6.patch
	"

prepare() {
	sed -i 's/-WCClinker//g' "${srcdir}/libunwind-${pkgver}/configure.ac"
	autoreconf -fvi
}

build() {
	# disable-minidebuginfo to avoid lzma_* function stubs causing issues with static linking
	# it's possible that we might be even interested in `-lunwind-$(arch) -llzma -lunwind` per other CMake-based projects
	# ref: https://github.com/libunwind/libunwind/issues/250 https://github.com/libunwind/libunwind/issues/586

	# shellcheck disable=2046
	LDFLAGS="$LDFLAGS -lucontext" CFLAGS="$CFLAGS -fno-stack-protector" \
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--enable-cxx-exceptions \
		--disable-minidebuginfo \
		$(want_check || echo --disable-tests)
	make
}

check() {
	make check||:  # v1.4.0 12 tests failing - https://github.com/libunwind/libunwind/issues/164
}

package() {
	make DESTDIR="$pkgdir" install
}


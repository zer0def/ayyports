pkgname=rust
pkgver=1.97.1
_mrustc_ver="0.12.0"
pkgrel=0
# Source tarballs for beta releases are listed here:
# https://static.rust-lang.org/dist/channel-rust-beta.toml
pkgdesc="Rust Programming Language toolchain"
url="https://www.rust-lang.org/"
arch="all"
license="Apache-2.0 OR MIT"

# 'cc' is needed at runtime just for linking. Someday rustc might invoke
# the linker directly, and then we'll only need 'ld'.
# See: https://github.com/rust-lang/rust/issues/11937
depends="gcc musl-dev"
checkdepends="libunwind-static"

# * Rust is self-hosted, so you need rustc (and cargo) to build rustc...
#   The last revision of this abuild that does not depend on itself (uses
#   prebuilt rustc and cargo) is 2e6769eb39eaff3029d8298fc02856623c563cd8.
# * Don't add libgit2-dev into make dependencies. There's no compatibility
#   guarantees between libgit2-sys and arbitrary system libgit2 versions;
#   when system libgit2 is upgraded to a new minor version, it may break
#   cargo and since we need cargo to rebuild cargo... this already happened
#   several times. For this reason we build cargo with vendored libgit2.

# technically we only need the target rust version's compiler-rt major, but add all anyway
makedepends_host="
	!libgit2-dev
	curl-dev
	libssh2-dev
	compiler-rt21
	llvm21-dev
	openssl-dev
	sqlite-dev
	zlib-dev
	"
makedepends_build="
	${makedepends_host}
	clang21
	file
	llvm21-test-utils
	python3
	tar
	xz-dev
	"

# XXX: This is a hack to allow this abuild to depend on itself. Adding "rust"
# to makedepends would not work, because abuild implicitly removes ${pkgname}
# and ${subpackages} from the abuild's dependencies.
provides="rust-bootstrap=${pkgver}-r${pkgrel}"
# !archcheck: needed for -src that contains some testing binaries.
# net: crates from crate.io
options="!archcheck net"

# Only cargo is needed for bootstrapping.
subpackages="
	cargo:_cargo
	${pkgname}-dbg
	${pkgname}-doc
	${pkgname}-clippy
	${pkgname}-clippy-doc:_clippy_doc
	${pkgname}-gdb::noarch
	${pkgname}-lldb::noarch
	${pkgname}-src::noarch
	${pkgname}-wasm
	cargo-bash-completions:_cargo_bashcomp:noarch
	cargo-zsh-completion:_cargo_zshcomp:noarch
	cargo-doc:_cargo_doc:noarch
	rustc-dev:_rustc_dev
	rustfmt
	rustfmt-doc:_rustfmt_doc
	wasm-component-ld:_wasm_cmld
	wasm-component-ld-dbg:_wasm_cmld_dbg
	"
case "${CHOST}" in
	aarch64*|x86_64*)
	subpackages="${subpackages} ${pkgname}-uefi"
	;;
esac
makedepends_build="
	${makedepends_build}
	wasi-libc
	patchelf
	"
makedepends_host="
	${makedepends_host}
	scudo-malloc21 scudo-malloc~21
	"
#source="https://github.com/thepowersgang/mrustc/archive/v${_mrustc_ver}.tar.gz  # by ← repository state or by release ↓?
source="https://github.com/thepowersgang/mrustc/archive/refs/tags/v${_mrustc_ver}.tar.gz
	musl-dylib.patch Cargo.toml

	rustc-1.90.0-src.tar.xz.noextract::https://static.rust-lang.org/dist/rustc-1.90.0-src.tar.xz
	rustc-1.91.1-src.tar.xz.noextract::https://static.rust-lang.org/dist/rustc-1.91.1-src.tar.xz
	rustc-1.92.0-src.tar.xz.noextract::https://static.rust-lang.org/dist/rustc-1.92.0-src.tar.xz
	rustc-1.93.1-src.tar.xz.noextract::https://static.rust-lang.org/dist/rustc-1.93.1-src.tar.xz
	rustc-1.94.1-src.tar.xz.noextract::https://static.rust-lang.org/dist/rustc-1.94.1-src.tar.xz
	rustc-1.95.0-src.tar.xz.noextract::https://static.rust-lang.org/dist/rustc-1.95.0-src.tar.xz
	rustc-1.96.1-src.tar.xz.noextract::https://static.rust-lang.org/dist/rustc-1.96.1-src.tar.xz
	rustc-1.97.1-src.tar.xz.noextract::https://static.rust-lang.org/dist/rustc-1.97.1-src.tar.xz

	alpine-move-py-scripts-to-share.patch
	do-not-install-libunwind-source.patch
	embed-metadata.patch
	gcc-eh-libunwind.patch
	install-template-shebang.patch
	no-export-ld-library-path.patch
	remove-musl-root.patch
	check-rustc
	"
#builddir="${srcdir}/rustc-${pkgver}-src"
_rust_llvm="1.90:21;1.91:21;1.92:21;1.93:21;1.94:21;1.95:21;1.96:21;1.97:21"  # >=1.88:21
_rust_changeid="1.90.0:144675 1.91.1:146435 1.92.0:147888 1.93.1:148911 1.94.1:149354 1.95.0:149354 1.96.1:154508 1.97.1:154587"

# secfixes:
#   1.96.1-r0:
#     - CVE-2025-15661
#     - CVE-2026-55199
#     - CVE-2026-55200
#   1.96.0-r0:

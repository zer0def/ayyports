# We have to add new architectures in multiple steps:
# 1. Compile with the upstream triplets, compiling alpine's triplets in
# 2. Compile again, now with our triplets selected as build/target, now that
#    rustc knows about them
_build="${CBUILD/-alpine/-unknown}"
_target="${CHOST/-alpine/-unknown}"  #_target="${CTARGET/-alpine/-unknown}" ?

_rlibdir="usr/lib/rustlib/${_target}/lib"
_sharedir="usr/share/rust"

ldpath="/${_rlibdir}"

export LIBSQLITE3_SYS_USE_PKG_CONFIG=1 OPENSSL_NO_VENDOR=1  # LIBGIT2_NO_VENDOR=1 LIBSSH2_SYS_USE_PKG_CONFIG=1
export RUST_BACKTRACE=full
export RUST_MIN_STACK=$((2**24))  # works only since 1.79, but it shouldn't be a problem before

export gztool="$(command -v pigz || echo gzip -9)"
export xztool="$(command -v pixz || echo xz -T0 -9e)"

# this is useful for when we have to patch vendored projects
_clear_vendor_checksums() {
	sed -i 's/\("files":{\)[^}]*/\1/' vendor/${1}/.cargo-checksum.json
}

_system_dylib(){
	_rustc_ver="${1:-1.90.0}"
	grep -nr 'crt_static_default\s*=\s*true' "${srcdir}/rustc-${_rustc_ver}-src/compiler/rustc_target/" | awk -F: '/linux/{print $1}' | sort -u | xargs -r -- sed -i 's@\(\s*\)\(\S*crt_static_default\s*=\s*true\)@\1//\2@g'  # disable default static linking on linux targets

	grep -nr 'objects_self_contained' "${srcdir}/rustc-${_rustc_ver}-src/compiler/rustc_target/" | awk -F: '/musl/{print $1}' | sort -u | xargs -r -- sed -i '/self_contained/d'  # musl-specific
	patch -Np1 -d "${srcdir}/rustc-${_rustc_ver}-src" -i "${srcdir}/musl-dylib.patch"

	## can't remove llvm, because musl targets require CRTs, rendering this effort a foregone conclusion https://github.com/rust-lang/rust/pull/71769
	#rm -rf "${srcdir}/rustc-${_rustc_ver}-src/src/llvm-project"
}

_unpack_build_dist() {
	local distname="${1}" destdir="${2}" tarball=

	case "${distname}" in
	rust-src)
		tarball="${srcdir}/rustc-${pkgver}-src/build/dist/rust-src-${pkgver}.tar.xz"
		;;
	rust-std-*)
		tarball="${srcdir}/rustc-${pkgver}-src/build/dist/rust-std-${pkgver}-${distname#rust-std-*}.tar.xz"
		;;
	*)
		tarball="${srcdir}/rustc-${pkgver}-src/build/dist/${distname}-${pkgver}-${_target}.tar.xz"
		;;
	esac

	tar -I "${xztool} -d" -xf "${tarball}" -C "${destdir}" --strip-components=2 --exclude=manifest.in --no-same-owner
}

prepare() {
	:||patch -Np1 -d "${srcdir}/mrustc-${_mrustc_ver}" -i "${srcdir}/56e4d7a37155526497354a9a1e500ff9dc8a423d.patch"  # mrustc cstdint patch
}

build() {
	mkdir -p "${srcdir}/bin"
	_old_path="${PATH}"
	export PATH="${srcdir}/bin:${PATH}" WASI_SDK_PATH=/usr LDFLAGS="${LDFLAGS} -fno-lto" \
		CFLAGS="${CFLAGS} -fno-lto -O2" CXXFLAGS="${CXXFLAGS} -fno-lto -O2"
	for j in LTO CODEGEN_UNITS PANIC OPT_LEVEL; do  # default abuild settings go buh-bye
		for i in $(env | awk -F= "/^CARGO_PROFILE_[^_]*_${j}/{print \$1}"); do unset "${i}"; :||export "${i}=off"; done
	done
	#RUSTFLAGS="${RUSTFLAGS} -Clto=off -Clinker-plugin-lto=off"

	cd "${srcdir}/mrustc-${_mrustc_ver}"
	export RUSTC_VERSION=1.90.0 MRUSTC_TARGET_VER=1.90 STD_ENV_ARCH="${CARCH}" PARLEVEL="${JOBS:-$(nproc)}"
	command -v ccache &>/dev/null && export MRUSTC_CCACHE=1 ||:
	make --trace bin/mrustc; make --trace -C tools/minicargo/; cp bin/minicargo bin/mrustc "${srcdir}/bin/"

	tar -C "${srcdir}" -xJf "${srcdir}/rustc-${RUSTC_VERSION}-src.tar.xz.noextract"
	mkdir -p "${srcdir}/rustc-${RUSTC_VERSION}-src/mrustc-stdlib/"
	cp "${srcdir}/Cargo.toml" "${srcdir}/rustc-${RUSTC_VERSION}-src/mrustc-stdlib/Cargo.toml"
	echo '#![no_core]' >"${srcdir}/rustc-${RUSTC_VERSION}-src/mrustc-stdlib/lib.rs"
	patch -Np0 -d "${srcdir}/rustc-${RUSTC_VERSION}-src" -i "${srcdir}/mrustc-${_mrustc_ver}/rustc-${RUSTC_VERSION}-src.patch"

	_system_dylib "${RUSTC_VERSION}"

	export MRUSTC_LIBDIR="${srcdir}/rustlib-${RUSTC_VERSION}"
	VENDOR_DIR="${srcdir}/rustc-${RUSTC_VERSION}-src/vendor"
	OVERRIDES="${srcdir}/mrustc-${_mrustc_ver}/rustc-${RUSTC_VERSION}-overrides.toml"

	cd "${srcdir}"
	minicargo --output-dir "${MRUSTC_LIBDIR}" --vendor-dir "${VENDOR_DIR}" -j ${JOBS:-$(nproc)} \
		--script-overrides "${srcdir}/mrustc-${_mrustc_ver}/script-overrides/stable-${RUSTC_VERSION}-linux/" \
		--manifest-overrides "${OVERRIDES}" "${srcdir}/rustc-${RUSTC_VERSION}-src/mrustc-stdlib"
	minicargo --output-dir "${MRUSTC_LIBDIR}" --manifest-overrides "${OVERRIDES}" -j ${JOBS:-$(nproc)} \
		"${srcdir}/mrustc-${_mrustc_ver}/lib/libproc_macro"

	_old_ld_library_path="${LD_LIBRARY_PATH}"
	export LLVM_CONFIG=/usr/bin/llvm-config-21 CFG_RELEASE_CHANNEL="stable" \
		LLVM_LINK_SHARED=1 REAL_LIBRARY_PATH_VAR="LD_LIBRARY_PATH" \
		LD_LIBRARY_PATH="${MRUSTC_LIBDIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
		CFG_RELEASE="${RUSTC_VERSION}" CFG_VERSION="${RUSTC_VERSION}-stable-mrustc" \
		RUSTC_INSTALL_BINDIR="${srcdir}/bin" CFG_COMPILER_HOST_TRIPLE="${_target}"

	RUSTC_BOOTSTRAP=1 minicargo --vendor-dir "${VENDOR_DIR}" --manifest-overrides "${OVERRIDES}" \
		--output-dir "${srcdir}/rustc-${RUSTC_VERSION}-src/build" --features llvm -j ${JOBS:-$(nproc)} \
		-L "${MRUSTC_LIBDIR}" "${srcdir}/rustc-${RUSTC_VERSION}-src/compiler/rustc"
	:||minicargo --vendor-dir "${VENDOR_DIR}" --manifest-overrides "${OVERRIDES}" -j ${JOBS:-$(nproc)} \
		--output-dir "${srcdir}/rustc-${RUSTC_VERSION}-src/build" --features llvm \
		-L "${MRUSTC_LIBDIR}" "${srcdir}/rustc-${RUSTC_VERSION}-src/compiler/rustc_driver"
	unset LLVM_CONFIG LLVM_LINK_SHARED REAL_LIBRARY_PATH REAL_LIBRARY_PATH_VAR
	export LD_LIBRARY_PATH="${_old_ld_library_path}"
	minicargo --vendor-dir "${VENDOR_DIR}" --manifest-overrides "${OVERRIDES}" -j ${JOBS:-$(nproc)} \
		--output-dir "${srcdir}/rustc-${RUSTC_VERSION}-src/build" --features vendored-openssl \
		-L "${MRUSTC_LIBDIR}" "${srcdir}/rustc-${RUSTC_VERSION}-src/src/tools/cargo"

	cp "${srcdir}/rustc-${RUSTC_VERSION}-src/build/rustc_main" "${srcdir}/bin/rustc"
	cp "${srcdir}/rustc-${RUSTC_VERSION}-src/build/cargo"      "${srcdir}/bin/cargo"
	rm -rf "${srcdir}/rustc-${RUSTC_VERSION}-src/build/"

	# sysroot is metapackage for std+panic_unwind+test
	# MRUSTC_PATH basename has to be either of ["rustc", "rust.exe"], due to minicargo-hardcoded condition
	_LIBDIR="${srcdir}/lib/rustlib/${_target}/lib"; mkdir -p "${_LIBDIR}"
	MRUSTC_PATH="${srcdir}/bin/rustc" minicargo --vendor-dir "${VENDOR_DIR}" -j ${JOBS:-$(nproc)} \
		--script-overrides "${srcdir}/mrustc-${_mrustc_ver}/script-overrides/stable-${RUSTC_VERSION}-linux/" \
		-L "${MRUSTC_LIBDIR}" --output-dir "${_LIBDIR}" "${srcdir}/rustc-${RUSTC_VERSION}-src/library/sysroot"

	# can't escape file templating…
	CARGO_HOME="${srcdir}/.cargo"; mkdir -p "${CARGO_HOME}"
	cat <<EOF >"${CARGO_HOME}/config"
[source.crates-io]
replace-with = "vendored-sources"
[source.vendored-sources]
directory = "${VENDOR_DIR}"
EOF
	ln -s config "${CARGO_HOME}/config.toml"

	export RUSTC="${srcdir}/bin/rustc" RUSTC_BOOTSTRAP=1 CARGO_HOME="${CARGO_HOME}" \
		LLVM_CONFIG=/usr/bin/llvm-config-21 LLVM_LINK_SHARED=1 REAL_LIBRARY_PATH_VAR="LD_LIBRARY_PATH" \
		RUSTFLAGS='-Z force-unstable-if-unmarked -C link_args=-Wl,-rpath,\$ORIGIN/../lib -C target-feature=-crt-static'

	cargo build --manifest-path "${srcdir}/rustc-${RUSTC_VERSION}-src/library/sysroot/Cargo.toml" \
		--target "${_target}" -j${JOBS:-$(nproc)} --release --verbose --features panic-unwind

	RUSTFLAGS="${RUSTFLAGS} -C panic=unwind" cargo build --target "${_target}" \
		--manifest-path "${srcdir}/rustc-${RUSTC_VERSION}-src/compiler/rustc/Cargo.toml" -j${JOBS:-$(nproc)} \
		--release --verbose --features llvm

	cp "${srcdir}/rustc-${RUSTC_VERSION}-src/target/${_target}/release/rustc-main" "${srcdir}/bin/rustc"
	cp "${srcdir}/rustc-${RUSTC_VERSION}-src/target/${_target}/release/librustc_driver.so" "${srcdir}/lib"
	export LD_LIBRARY_PATH="${srcdir}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
	RUSTFLAGS="${RUSTFLAGS} -C panic=unwind" cargo build --target "${_target}" \
		--manifest-path "${srcdir}/rustc-${RUSTC_VERSION}-src/src/tools/cargo/Cargo.toml" -j${JOBS:-$(nproc)} \
		--release --verbose

	unset LLVM_CONFIG LLVM_LINK_SHARED REAL_LIBRARY_PATH REAL_LIBRARY_PATH_VAR
	_old_path="${PATH}"

	for i in ${_rust_changeid}; do
		_major="${i%.*}";_major="${_major#*.}"
		tar -C "${srcdir}" --strip-components 2 -xJ \
			-f "${srcdir}/rustc-${_prev:-${RUSTC_VERSION}}-src/build/dist/rustc-${_prev:-${RUSTC_VERSION}}-${_target}.tar.xz" \
				"rustc-${_prev:-${RUSTC_VERSION}}-${_target}/rustc/bin" \
				"rustc-${_prev:-${RUSTC_VERSION}}-${_target}/rustc/lib" \
			|| cp "${srcdir}/rustc-${_prev:-${RUSTC_VERSION}}-src/target/${_target}/release/rustc-main" "${srcdir}/bin/rustc"
		tar -C "${srcdir}" --strip-components 2 -xJ "cargo-${_prev:-${RUSTC_VERSION}}-${_target}/cargo/bin" \
			-f "${srcdir}/rustc-${_prev:-${RUSTC_VERSION}}-src/build/dist/cargo-${_prev:-${RUSTC_VERSION}}-${_target}.tar.xz" || \
			cp "${srcdir}/rustc-${_prev:-${RUSTC_VERSION}}-src/src/tools/cargo/target/${_target}/release/cargo" "${srcdir}/bin/cargo"
		tar -C "${srcdir}" --strip-components 2 -xJ "rust-std-${_prev:-${RUSTC_VERSION}}-${_target}/rust-std-${_target}/lib" \
			-f "${srcdir}/rustc-${_prev:-${RUSTC_VERSION}}-src/build/dist/rust-std-${_prev:-${RUSTC_VERSION}}-${_target}.tar.xz" ||:
		_llvm_ver=$(set -eo pipefail;echo ${_rust_llvm}|tr ';' '\n'|grep "^${i%.*}:");_llvm_ver="${_llvm_ver#*:}"
		export PATH="/usr/lib/llvm${_llvm_ver}/bin${PATH:+:${PATH}}"

		tar -C "${srcdir}" -xJf "${srcdir}/rustc-${i%:*}-src.tar.xz.noextract"
		[ "${_major}" = "${MRUSTC_TARGET_VER}" ] || _system_dylib "${i%:*}"
		cd "${srcdir}/rustc-${i%:*}-src"

		local extra_conf_opts=""

		local tools="cargo" targets="${_target}"
		if [ "${pkgver}" != "${i%:*}" ]; then
			extra_conf_opts="${extra_conf_opts} --set=rust.incremental=true"
		else
			if [ "${_build}" != "${_target}" ]; then
				# Use variables with triplets since they are otherwise passed to the wrong targets
				_target="${_target}"
				export "PKG_CONFIG_SYSROOT_DIR_${_target//-/_}=${PKG_CONFIG_SYSROOT_DIR}" "PKG_CONFIG_PATH_${_target//-/_}=${PKG_CONFIG_PATH}"
				export "CFLAGS_${_target//-/_}=${CFLAGS}" "CXXFLAGS_${_target//-/_}=${CXXFLAGS}" "CFLAGS_${_build//-/_}=${BUILDCFLAGS} -O2" "CXXFLAGS_${_build//-/_}=${BUILDCXXFLAGS} -O2"
				unset RUSTFLAGS CC CXX CFLAGS CXXFLAGS PKG_CONFIG_SYSROOT_DIR PKG_CONFIG_PATH  # still might need disabling LTO?

				# Cross compiling is just a hack, make the hack work with alpine
				# https://github.com/rust-lang/rust/blob/f19142044f270760ce0ebc03b2c3a44217d8703d/compiler/rustc_llvm/build.rs#L327
				cat << EOF >"${srcdir}/bin/llvm-config"
#!/bin/sh -e
for i; do
	case "\${i}" in
		--ldflags) printf '-L%s/usr/lib/llvm${_llvm_ver}/lib\n' "\${CBUILDROOT}"; exit ;;
		--libdir) printf '%s/usr/lib/llvm${_llvm_ver}/lib\n' "\${CBUILDROOT}"; exit ;;
		--bindir) printf '%s/usr/lib/llvm${_llvm_ver}/bin\n' "\${CBUILDROOT}"; exit ;;
		# Enabled targets vary between arches
		--components) printf '%s\n' 'ipo bitreader bitwriter linker asmparser lto coverage instrumentation $(
				sed -n 's/^set(LLVM_TARGETS_TO_BUILD \(.*\))$/\1/p' "${CBUILDROOT}/usr/lib/llvm${_llvm_ver}/lib/cmake/llvm/LLVMConfig.cmake" | tr 'A-Z;' 'a-z '
		)'; exit ;;
	esac
done
exec "$(PATH="${_old_path}" command -v llvm-config)" "\${@}"
EOF
				chmod +x "${srcdir}/bin/llvm-config"
			fi  # [ "${_build}" != "${_target}" ]

			extra_conf_opts="${extra_conf_opts}
				--set=rust.incremental=false --set=rust.remap-debuginfo=true
				--set=rust.debuginfo-level=2 --set=rust.debuginfo-level-std=2
				"
			tools="${tools},clippy,src,rustdoc,rustfmt,rust-analyzer-proc-macro-srv,rust-demangler,wasm-component-ld"

			# absolutely do not set these here, rust "knows" what it's doing
			unset CARGO_PROFILE_RELEASE_LTO
			unset CARGO_PROFILE_RELEASE_OPT_LEVEL
			unset CARGO_PROFILE_RELEASE_PANIC
			unset CARGO_PROFILE_RELEASE_CODEGEN_UNITS

			# these invoke llvm build, nah…
			#[ "${_major}" -lt "83" ] || extra_conf_opts="${extra_conf_opts} --set=dist.vendor=false"
			#[ "${_major}" -lt "88" ] || extra_conf_opts="${extra_conf_opts} --set=gcc.download-ci-gcc=false"

			if command -v ccache &>/dev/null; then
				[ "${_major}" -lt "86" ] && extra_conf_opts="${extra_conf_opts} --set=llvm.ccache=true" || extra_conf_opts="${extra_conf_opts} --set=build.ccache=true"
			fi

			_optimized_compiler_builtins_ver="91"  #_optimized_compiler_builtins_ver="86"  #== boolean type
			[ -z "${_prev}" ] || extra_conf_opts="${extra_conf_opts} --enable-profiler"
			[ "${_major}" -lt "77" ] || extra_conf_opts="${extra_conf_opts} --set=change-id=${i#*:}"
			[ "${_major}" -lt "${_optimized_compiler_builtins_ver}" ] || extra_conf_opts="${extra_conf_opts}
				--set=target.${_target}.optimized-compiler-builtins=$(/usr/lib/llvm${_llvm_ver}/bin/clang -print-resource-dir)/lib/linux/libclang_rt.builtins-${_target%%-*}.a"

			if subpackage_types_has wasm; then
				targets="${targets},wasm32-unknown-unknown"
				extra_conf_opts="${extra_conf_opts}
					--set=target.wasm32-unknown-unknown.sanitizers=false
					--set=target.wasm32-unknown-unknown.profiler=false
					--set=target.wasm32-unknown-unknown.cc=clang-${_llvm_ver}
					--set=target.wasm32-unknown-unknown.linker=wasm-ld
					"

				[ "${_major}" -lt "78" ] || _extra_targets="${_extra_targets} wasm32-wasip1" \
					_target_wasi_preview="wasm32-wasip1-threads wasm32-wasip2"
				[ "${_major}" -lt "84" ] || _extra_targets="${_extra_targets} wasm32v1-none"

				for t in ${_extra_targets} ${_target_wasi_preview:-wasm32-wasi-preview1-threads wasm32-wasi-preview2}; do
					targets="${targets},${t}"
					extra_conf_opts="${extra_conf_opts}
						--set=target.${t}.sanitizers=false
						--set=target.${t}.profiler=false
						--set=target.${t}.wasi-root=/usr/share/wasi-sysroot
						--set=target.${t}.cc=clang-${_llvm_ver}
						--set=target.${t}.cxx=clang++-${_llvm_ver}
						--set=target.${t}.ar=llvm${_llvm_ver}-ar
						--set=target.${t}.ranlib=llvm${_llvm_ver}-ranlib
						--set=target.${t}.linker=wasm-ld
						"
				done
			fi  # subpackage_types_has wasm

			local "_uefi_target=${CHOST%%-*}-unknown-uefi"
			if subpackage_types_has uefi; then
				targets="${targets},${_uefi_target}"
				extra_conf_opts="${extra_conf_opts}
					--set=target.${_uefi_target}.crt-static=true
					--set=target.${_uefi_target}.cc=clang-${_llvm_ver}
					--set=target.${_uefi_target}.linker=lld
					--set=target.${_uefi_target}.profiler=false
					--set=target.${_uefi_target}.optimized-compiler-builtins=false
					"
			fi
		fi  # [ "${pkgver}" = "${i%:*}" ]
		#[ "${_major}" -lt "87" ] && extra_conf_opts="${extra_conf_opts} --set=rust.description='Alpine Linux Rust ${i%:*}-r${pkgrel}'" || extra_conf_opts="${extra_conf_opts} --set=build.description='Alpine Linux Rust ${i%:*}-r${pkgrel}'"

			#--set="rust.incremental=$([ -n "${BOOTSTRAP}" ] && echo true || echo false)" \
		# ./configure will not run when bootstrap.toml exists,
		# so assume we are restarting the build with ./x.py
		[ -f "bootstrap.toml" ] || ./configure \
			--build="${_build}" \
			--host="${_target}" \
			--target="${targets}" \
			--prefix="/usr" \
			--release-channel="stable" \
			--enable-local-rust \
			--disable-docs \
			--enable-extended \
			--tools="${tools}" \
			--enable-llvm-link-shared \
			--enable-option-checking \
			--enable-locked-deps \
			--enable-vendor \
			--dist-compression-formats=xz \
			--set="dist.compression-profile=fast" \
			--python="python3" \
			--set="rust.codegen-units=1" \
			--set="rust.codegen-units-std=1" \
			--set="rust.deny-warnings=false" \
			--set="rust.lld=false" \
			--set="rust.backtrace-on-ice=true" \
			--set="build.build-stage=2" --set="build.doc-stage=2" --set="build.test-stage=2" \
			--set="llvm.download-ci-llvm=false" --set="rust.download-rustc=false" \
			--set="rust.lto=off" \
			--set="target.${_target}.llvm-config=${srcdir}/bin/llvm-config" \
			--set="target.${_target}.crt-static=false" \
			--set="target.${_target}.cc=${CROSS_COMPILE}cc" \
			--set="target.${_target}.cxx=${CROSS_COMPILE}c++" \
			--set="target.${_target}.ar=${CROSS_COMPILE}ar" \
			--set="target.${_target}.linker=${CROSS_COMPILE}cc" \
			--set="target.${_build}.llvm-config=$(command -v llvm-config)" \
			--set="target.${_build}.crt-static=false" \
			--set="target.${_build}.cc=cc" \
			--set="target.${_build}.cxx=c++" \
			--set="target.${_build}.ar=ar" \
			--set="target.${_build}.linker=cc" \
			${extra_conf_opts}

		python3 ./x.py dist -vv --jobs ${JOBS:-$(nproc)} ${BOOTSTRAP:+cargo rustc rust-std}

		cd "${srcdir}/"
		#rm -rf "${srcdir}/rustc-${_prev_prev}-src";_prev_prev="${_prev}" _prev="${i%:*}"
		rm -rf "${srcdir}/rustc-${_prev}-src";_prev="${i%:*}"
		export PATH="${_old_path}" LD_LIBRARY_PATH="${_old_ld_library_path}"
	done  # for i in ${_rust_changeid}
}

check() {
	# At this moment lib/rustlib/${CHOST}/lib does not contain a complete
	# copy of the .so libs from lib (they will be copied there during
	# 'x.py install'). Thus we must set LD_LIBRARY_PATH for tests to work.

  # is riscv64 still broken?

	msg "Setting up test env..."

	mkdir -p "${srcdir}/rustc-${pkgver}-src/test-rustc"

	_unpack_build_dist rustc    "${srcdir}/rustc-${pkgver}-src/test-rustc" &
	_unpack_build_dist rust-std "${srcdir}/rustc-${pkgver}-src/test-rustc" &
	wait

	export LD_LIBRARY_PATH="${srcdir}/rustc-${pkgver}-src/test-rustc/lib/rustlib/${CHOST}/lib"  # CTARGET?

	msg "Sanity checks..."
	"${srcdir}/check-rustc" "${srcdir}/rustc-${pkgver}-src/test-rustc/bin/rustc"

	# XXX: There's some problem with these tests, we will figure it out later.
	#	make check \
	#		LD_LIBRARY_PATH="${_stage0dir}/lib" \
	#		VERBOSE=1

	# these rebuild the whole compiler which takes a long time
	# msg "Running tests for cargo..."
	# CFG_DISABLE_CROSS_TESTS=1 python3 ./x.py test --no-fail-fast src/tools/cargo

	unset LD_LIBRARY_PATH
}

package() {
	# merged into main package
	provides="${provides} rust-stdlib=${pkgver}-r${pkgrel}"
	replaces="rust-stdlib"

	mkdir -p "${pkgdir}/usr"

	cd "${pkgdir}"

	_unpack_build_dist rustc     "${pkgdir}/usr" &
	_unpack_build_dist rust-std  "${pkgdir}/usr" &
	_unpack_build_dist cargo     "${pkgdir}/usr" &
	wait

	_unpack_build_dist rustc-dev "${pkgdir}/usr" &
	_unpack_build_dist rust-src  "${pkgdir}/usr" &
	wait
	_unpack_build_dist clippy    "${pkgdir}/usr" &
	_unpack_build_dist rustfmt   "${pkgdir}/usr" &
	if subpackage_types_has wasm; then
		_unpack_build_dist rust-std-wasm32-unknown-unknown "${pkgdir}/usr" &
		_unpack_build_dist rust-std-wasm32-wasip1          "${pkgdir}/usr" &
		_unpack_build_dist rust-std-wasm32-wasip1-threads  "${pkgdir}/usr" &
		_unpack_build_dist rust-std-wasm32-wasip2          "${pkgdir}/usr" &
	fi
	if subpackage_types_has uefi; then
		_unpack_build_dist "rust-std-${_target%%-*}-unknown-uefi" "${pkgdir}/usr" &
	fi
	wait

	# Prevent rustc-dev from providing the same *.so files,
	# which causes it to conflict with the main rust package.
	local libpath; for libpath in usr/lib/*.so; do
		rm "${_rlibdir}/${libpath##*/}"
		ln -s "/${libpath}" "${_rlibdir}/"
	done

	# We don't want to include stuff like rust-llvm-* tools, as we will use the
	# system tools.
	rm -f "usr/lib/rustlib/${_target}/bin/rust-llvm-"*

	# Python scripts are noarch, so move them to /usr/share.
	# Requires move-py-scripts-to-share.patch to be applied.
	_mv usr/lib/rustlib/etc/*.py "${_sharedir}/etc/"
	rmdir -p usr/lib/rustlib/etc 2>/dev/null ||:

	_mv usr/etc/bash_completion.d/cargo usr/share/bash-completion/completions/
	rmdir -p usr/etc/bash_completion.d 2>/dev/null ||:

	_mv usr/lib/rustlib/src/rust usr/src/
	ln -s ../../../src/rust usr/lib/rustlib/src/rust
	mv usr/lib/rustlib/rustc-src/rust usr/src/rustc
	ln -s ../../../src/rustc usr/lib/rustlib/rustc-src/rust

	# we don't want to introduce a usr/etc/ but the file could still be useful
	# even though there's the --print target-spec-json-schema option
	_mv usr/etc/target-spec-json-schema.json usr/share/doc/rust/
	rmdir usr/etc 2>/dev/null ||:

	# Remove some clutter.
	cd "${pkgdir}/usr/lib/rustlib"
	rm -f components install.log manifest-* rust-installer-version uninstall.sh
	if [ "${_build}" != "${_target}" ]; then
		rm -rf "${pkgdir}/usr/lib/rustlib/${_build}"
	fi
	# the below were added with the 1.94.0 upgrade and almost doubled the size
	# of the rust-wasm and rust-uefi subpackages and don't seem to be needed
	rm -rf "${pkgdir}/usr/lib/rustlib/wasm32-"*/lib/*.rmeta \
		"${pkgdir}/usr/lib/rustlib/"*-uefi/lib/*.rmeta
	# if they would later be found to be useful, please move them to
	# rust-wasm-dev and rust-uefi-dev subpackages

	# for some reason the tar archive gets some root-only files for rlibs
	find "${pkgdir}/usr/lib/rustlib" -type f -perm -600 -exec chmod 0644 {} \+
	find "${pkgdir}/usr/lib/rustlib" -type f -perm -700 -exec chmod 0755 {} \+

	# link scudo to tools by default on architectures where it works well
	# this is roughly 20+% faster with no downside except slightly higher
	# memory use, but this is a compiler that already uses a ton of memory
	case "${CARCH}" in
	arm*) ;;
	*)
		patchelf --add-needed libscudo.so \
			"${pkgdir}/usr/bin/cargo" \
			"${pkgdir}/usr/bin/rustc" \
			"${pkgdir}/usr/bin/rustdoc"
		;;
	esac
}

_rustc_dev() {
	pkgdesc="${pkgdesc} (compiler libraries)"

	# needs embed-metadata.patch
	amove "${_rlibdir}/lib"*.rmeta \
		"${_rlibdir}/lib"*.so
}

wasm() {
	pkgdesc="WebAssembly targets for rust"
	url="https://rust-lang.org/what/wasm/"
	depends="rust=${pkgver}-r${pkgrel} lld wasi-libc"

	amove usr/lib/rustlib/wasm32-*
}

uefi() {
	pkgdesc="UEFI targets for rust"
	url="https://rust-osdev.com/uefi-book"
	depends="rust=${pkgver}-r${pkgrel} lld"

	amove usr/lib/rustlib/*-uefi
}

analysis() {
	pkgdesc="Compiler analysis data for the Rust standard library"
	depends="${pkgname}=${pkgver}-r${pkgrel}"

	amove "${_rlibdir}/../analysis"
}

gdb() {
	pkgdesc="GDB pretty printers for Rust"
	url="https://rustc-dev-guide.rust-lang.org/debugging-support-in-rustc.html"
	depends="${pkgname}=${pkgver}-r${pkgrel} gdb"

	amove usr/bin/rust-gdb*
	amove "${_sharedir}/etc/gdb_"*.py
}

lldb() {
	pkgdesc="LLDB pretty printers for Rust"
	url="https://rustc-dev-guide.rust-lang.org/debugging-support-in-rustc.html"
	depends="${pkgname}=${pkgver}-r${pkgrel} lldb py3-lldb"

	amove usr/bin/rust-lldb
	amove "${_sharedir}/etc/lldb_"*.py
	amove usr/lib/rustlib/etc/lldb_commands
}

clippy() {
	pkgdesc="Lints to catch common mistakes and improve your Rust code"
	license="MIT or Apache-2.0"
	url="https://doc.rust-lang.org/clippy/"
	depends="cargo=${pkgver}-r${pkgrel}"

	amove usr/bin/cargo-clippy
	amove usr/bin/clippy-driver
}

_clippy_doc() {
	pkgdesc="Rust Code Linter (documentation)"
	install_if="docs rust-clippy=${pkgver}-r${pkgrel}"

	# XXX: This is hackish!
	cd "${pkgdir}/../${pkgname}-doc"
	_mv "${srcdir}/rustc-${pkgver}-src/src/tools/clippy/book/src/"* usr/share/doc/clippy/* \
		"${subpkgdir}/usr/share/doc/rust-clippy/" ||:
	rm -rf usr/share/doc/clippy 2>/dev/null ||:
}

src() {
	pkgdesc="${pkgdesc} (source code)"
	license="(${license}) AND OFL-1.1 AND GPL-3.0-or-later AND GPL-3.0-with-GCC-exception AND CC-BY-SA-3.0 LGPL-3.0"
	url="https://github.com/rust-lang/rust/tree/${pkgver}"
	depends="${pkgname}=${pkgver}-r${pkgrel}"

	amove usr/src \
		usr/lib/rustlib/src \
		usr/lib/rustlib/rustc-src
}

_cargo() {
	pkgdesc="The Rust package manager"
	license="(Apache-2.0 OR MIT) AND UNLICENSE"
	url="https://doc.rust-lang.org/cargo/"
	depends="${pkgname}=${pkgver}-r${pkgrel}"
	# XXX: See comment on top-level provides=.
	provides="cargo-bootstrap=${pkgver}-r${pkgrel}"

	amove usr/bin/cargo
}

_cargo_bashcomp() {
	default_bashcomp

	pkgdesc="Bash completions for cargo"
	url="https://doc.rust-lang.org/cargo/"
	install_if="cargo=${pkgver}-r${pkgrel} bash-completion"
}

_cargo_zshcomp() {
	default_zshcomp

	pkgdesc="ZSH completions for cargo"
	url="https://doc.rust-lang.org/cargo/"
	install_if="cargo=${pkgver}-r${pkgrel} zsh"
}

_cargo_doc() {
	pkgdesc="The Rust package manager (documentation)"
	url="https://doc.rust-lang.org/cargo/"
	install_if="docs cargo=${pkgver}-r${pkgrel}"

	# XXX: This is hackish!
	cd "${pkgdir}/../${pkgname}-doc"
	_mv usr/share/man/man1/cargo* "${subpkgdir}/usr/share/man/man1/"
	_mv usr/share/doc/cargo "${subpkgdir}/usr/share/doc/"
}

rustfmt() {
	pkgdesc="Rust Code Formatter"
	license="Apache-2.0 OR MIT"
	url="https://rust-lang.github.io/rustfmt/"
	depends="cargo=${pkgver}-r${pkgrel}"

	amove usr/bin/rustfmt
	amove usr/bin/cargo-fmt
}

_rustfmt_doc() {
	pkgdesc="Rust Code Formatter (documentation)"
	url="https://rust-lang.github.io/rustfmt/"
	install_if="docs rustfmt=${pkgver}-r${pkgrel}"

	cd "${pkgdir}/../${pkgname}-doc"
	_mv usr/share/doc/rustfmt "${subpkgdir}/usr/share/doc/"
	install -Dm0644 -t "${subpkgdir}/usr/share/doc/rustfmt/" \
		"${srcdir}/rustc-${pkgver}-src/src/tools/rustfmt/README.md" \
		"${srcdir}/rustc-${pkgver}-src/src/tools/rustfmt/Configurations.md" \
		"${srcdir}/rustc-${pkgver}-src/src/tools/rustfmt/Design.md"
}

_wasm_cmld() {
	pkgdesc="Command line linker for creating WebAssembly components"
	url="https://github.com/bytecodealliance/wasm-component-ld"
	depends="lld22" # wasm-ld

	install -Dm0755 -t "${subpkgdir}/usr/bin/" \
		"${pkgdir}/usr/lib/rustlib/${CHOST}/bin/wasm-component-ld"
}

_wasm_cmld_dbg() {
	pkgdesc="Command line linker for creating WebAssembly components (debug info)"
	url="https://github.com/bytecodealliance/wasm-component-ld"
	depends="wasm-component-ld=${pkgver}-r${pkgrel}"

	cd "${pkgdir}/../${pkgname}-dbg"
	_dbgpath="usr/lib/debug/usr/lib/rustlib/${CHOST}/bin"
	_mv "${_dbgpath}/wasm-component-ld.debug" "${subpkgdir}/${_dbgpath}/"
}

_mv() {
	local dest; for dest; do :; done  # get last argument
	mkdir -p "${dest}"
	mv "${@}"
}

